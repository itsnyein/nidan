{
  "name": "nidan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "CLI that compares two Git refs in a JavaScript/TypeScript repository and reports the direct usages potentially affected by changed callables.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.4",
  "bin": {
    "nidan": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:randomized": "vitest run randomized",
    "rerun:isolated": "node scripts/rerun-isolated.mjs"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ts-morph": "28.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
