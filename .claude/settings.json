{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git branch *)",
      "Bash(gh pr *)",
      "Bash(gh repo *)",
      "Bash(gh release *)"
    ]
  },
  "attribution": {
    "commit": false,
    "pr": false
  }
}
