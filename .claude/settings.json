      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch -m*)",
      "Bash(git branch -M*)",
      "Bash(git filter-branch *)",
      "Bash(git commit --amend*)",
      "Bash(git config *)",
