{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git checkout:*)",
      "Bash(git pull --ff-only)",
      "Bash(git rebase origin/main)",
      "Bash(git rebase main)",
      "Bash(gh auth switch -u Its-Nyein)",
      "Bash(gh auth status)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * :*)",
      "Bash(git push --delete*)",
      "Bash(git push --mirror*)",
      "Bash(git tag *)",
      "Bash(git merge *)",
      "Bash(git rebase --onto*)",
      "Bash(git rebase -i*)",
      "Bash(git rebase --interactive*)",
      "Bash(git reset *)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch -m*)",
      "Bash(git branch -M*)",
      "Bash(git filter-branch *)",
      "Bash(git commit --amend*)",
      "Bash(git config *)",
      "Bash(gh auth setup-git*)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh repo *)",
      "Bash(gh release *)",
      "Bash(gh api --method DELETE*)",
      "Bash(gh api -X DELETE*)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
